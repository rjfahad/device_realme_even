# Block device queue tuning
genfscon sysfs /block/mmcblk0/queue u:object_r:sysfs_block_queue:s0
genfscon sysfs /block/sdc/queue u:object_r:sysfs_block_queue:s0

# Kernel tunables
genfscon sysfs /kernel/rcu_expedited u:object_r:sysfs_kernel_tunable:s0
genfscon sysfs /kernel/mm/swap/vma_ra_enabled u:object_r:sysfs_kernel_tunable:s0

# CPU tunables
genfscon sysfs /devices/system/cpu/eas u:object_r:sysfs_cpu:s0
genfscon sysfs /devices/system/cpu/cpufreq u:object_r:sysfs_cpu:s0

# Battery meter
genfscon sysfs /devices/platform/battery_meter u:object_r:sysfs_battery_meter:s0
genfscon sysfs /bus/platform/devices/battery u:object_r:sysfs_battery_meter:s0

# USB rawbulk
genfscon sysfs /class/usb_rawbulk u:object_r:sysfs_usb_rawbulk:s0

# Power tunables (pm_async, pm_freeze_timeout)
genfscon sysfs /power/pm_async u:object_r:sysfs_power:s0
genfscon sysfs /power/pm_freeze_timeout u:object_r:sysfs_power:s0

# Tracing
genfscon sysfs /kernel/tracing u:object_r:sysfs_kernel_tunable:s0

# Module params
genfscon sysfs /module/musb_hdrc/parameters u:object_r:sysfs_usb_nonplat:s0

# UDC device
genfscon sysfs /class/udc u:object_r:sysfs_usb_nonplat:s0
