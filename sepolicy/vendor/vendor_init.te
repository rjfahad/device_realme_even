allow vendor_init device:file { create write };
allow vendor_init proc_tp:file rw_file_perms;
allow vendor_init proc_vm:file rw_file_perms;
allow vendor_init sysfs_otg_switch:file rw_file_perms;

# Read/write oplus fingerprint property (fingerprint fp_id at boot)
get_prop(vendor_init, system_oplus_fingerprint_prop)
set_prop(vendor_init, system_oplus_fingerprint_prop)

# Read oplus sensor property
get_prop(vendor_init, system_oplus_sensor_prop)

# Set MTK picture quality props at boot
set_prop(vendor_init, vendor_mtk_pq_prop)
